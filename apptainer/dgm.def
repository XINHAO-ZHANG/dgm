Bootstrap: docker
From: python:3.10-slim

%post
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        git \
        && apt-get clean && rm -rf /var/lib/apt/lists/*
    mkdir -p /dgm

%environment
    export HOME=/root

%runscript
    exec tail -f /dev/null
